<Window x:Class="SolidModelBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Title="Settings" Height="620" Width="820" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <DockPanel>
        <!-- Top Title Bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="ButtonClose" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="30" Height="30" ToolTip="Close" SnapsToDevicePixels="True">
                <Canvas Width="10" Height="10">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                </Canvas>
            </Button>
            <Border x:Name="BorderHeader" Background="{DynamicResource WindowBack}" Height="30">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WindowFore}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Search Bar Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBack}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource WindowFore}"/>
                <TextBox x:Name="TextBoxSearch" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="6,2"
                         FontSize="11" ToolTip="Type to search settings across all sections (e.g. camera, fov, gcode, color)"/>
                <Button x:Name="ButtonClearSearch" Grid.Column="2" Content="✕" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Clear search filter"/>
            </Grid>
        </Border>

        <!-- Bottom Command Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBack}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="ButtonLoadDefaults" Content="Reset to Defaults" Width="120" Height="26" Margin="0,0,8,0"/>
                    <Button x:Name="ButtonOpenInTextEditor" Content="Open INI" Width="80" Height="26"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ButtonSave" Content="Save &amp; Close" Width="95" Height="26" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button x:Name="ButtonCancel" Content="Cancel" Width="75" Height="26"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Settings Body: 2-Column Grid with System GroupBoxes -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Group: General & Interface -->
                    <GroupBox x:Name="GroupInterface" Header="General &amp; Interface" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <StackPanel>
                            <CheckBox x:Name="CheckShowFilePanel" Content="Show file navigation panel by default" Margin="0,4"/>
                            <CheckBox x:Name="CheckColorizeFiles" Content="Different colors for files by extension" Margin="0,4"/>
                            <CheckBox x:Name="CheckSortFilesByExtensions" Content="Sort files by extensions" Margin="0,4"/>
                            <CheckBox x:Name="CheckUseSystemWindowStyle" Content="Use system style for app windows" Margin="0,4"/>
                            <CheckBox x:Name="CheckUnsmoothAfterLoading" Content="CAD flat shading for loaded models" Margin="0,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Group: Camera & Viewport -->
                    <GroupBox x:Name="GroupCamera" Header="Camera &amp; Viewport" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="CheckCenterCameraAtPointsAverageCenter" Grid.Row="0" Grid.ColumnSpan="2"
                                      Content="Default camera look at points average center" Margin="0,4,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Normal FOV (degrees):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TextFov" Grid.Row="1" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fisheye FOV (degrees):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TextFishEyeFov" Grid.Row="2" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Camera initial shift:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TextCameraInitialShift" Grid.Row="3" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Model rotation step (deg):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TextModelRotationAngle" Grid.Row="4" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>
                        </Grid>
                    </GroupBox>

                    <!-- Group: G-Code Import -->
                    <GroupBox x:Name="GroupGCode" Header="G-Code Import" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <StackPanel>
                            <TextBlock Text="ℹ Reload model [F5] after modifying G-Code parameters." FontStyle="Italic"
                                       FontSize="11" Foreground="{DynamicResource WindowFore}" Opacity="0.8" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="GCODE line ends extensions:" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="TextGCodeLineEnds" Grid.Row="0" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Layer height (mm):" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="TextGCodeLayerHeight" Grid.Row="1" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Line width (mm):" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox x:Name="TextGCodeLineWidth" Grid.Row="2" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">
                    <!-- Group: Colors & Materials -->
                    <GroupBox x:Name="GroupMaterials" Header="Colors &amp; Materials" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Model Diffuse Color:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorDiffuse" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Model Specular Highlight:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorSpecular" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ambient Light Color:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorAmbient" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Directional Key Light:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorLight1" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Directional Fill Light:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorLight2" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Directional Back Light:" VerticalAlignment="Center"/>
                                <local:ColorInput x:Name="ColorLight3" Grid.Column="1"/>
                            </Grid>

                            <CheckBox x:Name="CheckBacksideDiffuseMaterial" Content="Show backside contrasting color" Margin="0,8,0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Group: External Applications -->
                    <GroupBox x:Name="GroupApps" Header="External Applications" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="ButtonAddApp" Content="+ Add Application..." Height="24" Padding="8,0" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelAppsList"/>
                            </ScrollViewer>
                        </StackPanel>
                    </GroupBox>

                    <!-- Group: File Associations -->
                    <GroupBox x:Name="GroupAssociations" Header="File Associations" Margin="0,0,0,12" Padding="8,6" Foreground="{DynamicResource WindowFore}">
                        <StackPanel>
                            <TextBlock Text="Associate 3D file formats with SolidModelBrowser (Current User):"
                                       FontSize="11" Foreground="{DynamicResource WindowFore}" Opacity="0.8" Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelAssociationsList"/>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ButtonSelectAllAssoc" Content="Select All" Width="80" Height="24" Margin="0,0,8,0"/>
                                <Button x:Name="ButtonDeselectAllAssoc" Content="Deselect All" Width="90" Height="24"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
