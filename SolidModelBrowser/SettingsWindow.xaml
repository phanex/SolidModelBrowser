<Window x:Class="SolidModelBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Title="Settings"
        Width="740" Height="480" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBack}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <DockPanel>
        <!-- Bottom Command Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBack}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="ButtonLoadDefaults" Content="Reset to Defaults" Width="120" Height="26" Margin="0,0,8,0"/>
                    <Button x:Name="ButtonOpenInTextEditor" Content="Open INI" Width="80" Height="26"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ButtonSave" Content="Save" Width="80" Height="26" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button x:Name="ButtonCancel" Content="Cancel" Width="80" Height="26"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: 2 Columns (Left Navigation Sidebar + Right Content Area) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBack}">
                <ListBox x:Name="ListCategories" Background="Transparent" BorderThickness="0" Margin="4,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="General" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                    <ListBoxItem Content="Viewport" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                    <ListBoxItem Content="Colors" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                    <ListBoxItem Content="G-Code" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                    <ListBoxItem Content="External Apps" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                    <ListBoxItem Content="File Associations" Height="32" Padding="12,0" VerticalContentAlignment="Center" FontSize="12"/>
                </ListBox>
            </Border>

            <!-- Separator Line -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource Separator}"/>

            <!-- Right Content Panels (No vertical scrollbars!) -->
            <Grid Grid.Column="2" Margin="20,16,20,16">
                <!-- 1. General Panel -->
                <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                    <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,16"/>

                    <TextBlock Text="File Panel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="CheckShowFilePanel" Content="Show file panel" Margin="0,4"/>
                    <CheckBox x:Name="CheckColorizeFiles" Content="Colorize files by extension" Margin="0,4"/>
                    <CheckBox x:Name="CheckSortFilesByExtensions" Content="Sort files by extension" Margin="0,4"/>

                    <TextBlock Text="Appearance &amp; Shading" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,16,0,6"/>
                    <CheckBox x:Name="CheckUnsmoothAfterLoading" Content="CAD flat shading" Margin="0,4"/>
                    <CheckBox x:Name="CheckLightTheme" Content="Light theme" Margin="0,4"/>
                    <CheckBox x:Name="CheckUseSystemWindowStyle" Content="Use system style for main window" Margin="0,4"/>
                </StackPanel>

                <!-- 2. Viewport Panel -->
                <StackPanel x:Name="PanelViewport" Visibility="Collapsed">
                    <TextBlock Text="Viewport &amp; Camera" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Normal FOV (degrees):" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextFov" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fisheye FOV (degrees):" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextFishEyeFov" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera initial shift:" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextCameraInitialShift" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Rotation angle (degrees):" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextModelRotationAngle" Grid.Row="3" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Wireframe edge scale:" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextWireframeEdgeScale" Grid.Row="4" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>
                    </Grid>

                    <CheckBox x:Name="CheckCenterCameraAtPointsAverageCenter" Content="Center camera on mass center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                </StackPanel>

                <!-- 3. Colors Panel (3-Column Grid) -->
                <StackPanel x:Name="PanelColors" Visibility="Collapsed">
                    <TextBlock Text="Colors &amp; Materials" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="Model Diffuse" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorDiffuse"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                            <TextBlock Text="Model Specular" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorSpecular"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Model Emissive" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorEmissive"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="Backside Diffuse" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorBackDiffuse"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,14">
                            <TextBlock Text="Ambient Light" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorAmbient"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Directional Light 1" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorLight1"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                            <TextBlock Text="Directional Light 2" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorLight2"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,14">
                            <TextBlock Text="Directional Light 3" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorLight3"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Ground Diffuse" FontSize="11" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                            <local:ColorInput x:Name="ColorGroundDiffuse"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="CheckBacksideDiffuseMaterial" Content="Show backside in custom color" Margin="0,6,0,0" Foreground="{DynamicResource WindowFore}"/>
                </StackPanel>

                <!-- 4. G-Code Panel -->
                <StackPanel x:Name="PanelGCode" Visibility="Collapsed">
                    <TextBlock Text="G-Code Import" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                    <TextBlock Text="Changes apply after reloading model" FontSize="11" Foreground="{DynamicResource WindowFore}" Opacity="0.7" Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Layer height (mm):" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextGCodeLayerHeight" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Line width (mm):" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextGCodeLineWidth" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Line ends extension:" VerticalAlignment="Center" Margin="0,6" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextGCodeLineEnds" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,3"/>
                    </Grid>
                </StackPanel>

                <!-- 5. External Apps Panel -->
                <DockPanel x:Name="PanelApps" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="External Applications" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ButtonAddApp" Content="+ Add Application..." Height="26" Padding="12,0" Margin="0,0,8,0"/>
                        <Button x:Name="ButtonDetectSlicers" Content="Auto-detect Slicers" Height="26" Padding="12,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanelAppsList"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- 6. File Associations Panel -->
                <StackPanel x:Name="PanelAssociations" Visibility="Collapsed">
                    <TextBlock Text="Windows File Associations (HKCU)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowFore}" Margin="0,0,0,4"/>
                    <TextBlock Text="Associate 3D file formats with SolidModelBrowser in current user profile" FontSize="11" Foreground="{DynamicResource WindowFore}" Opacity="0.7" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Launch Arguments:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource WindowFore}"/>
                        <TextBox x:Name="TextAssocArgs" Text="&quot;%1&quot;" Width="160" Height="24" VerticalContentAlignment="Center" ToolTip="Command line arguments passed to SolidModelBrowser"/>
                    </StackPanel>

                    <WrapPanel x:Name="PanelAssociationsList" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ButtonSelectAllAssoc" Content="Select All" Width="90" Height="26" Margin="0,0,8,0"/>
                        <Button x:Name="ButtonDeselectAllAssoc" Content="Deselect All" Width="90" Height="26"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
