<Window x:Class="SolidModelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Title="Solid Model Browser" Height="600" Width="800" MinWidth="600" MinHeight="400">

    <Grid>
        <local:Scene x:Name="scene" />

        <DockPanel x:Name="MainContainer">

            <!-- MODERN WINDOW TOOLBAR & TITLEBAR -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4" MouseDown="Handler_MouseDown" Background="{DynamicResource TransparentHandle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Toolbar -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2,0,2">
                    <!-- 1. Sidebar Toggle -->
                    <ToggleButton x:Name="ButtonToggleFilePanel" ToolTip="Toggle file navigation panel [Tab / Ctrl+B]" Width="30" Height="30" Margin="0,0,2,0">
                        <Path Data="M2.5,3.5 L15.5,3.5 A1.5,1.5 0 0,1 17,5 L17,13 A1.5,1.5 0 0,1 15.5,14.5 L2.5,14.5 A1.5,1.5 0 0,1 1,13 L1,5 A1.5,1.5 0 0,1 2.5,3.5 Z M6.5,3.5 L6.5,14.5"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.5" Width="16" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 2. File Actions -->
                    <Button x:Name="ButtonReloadModel" ToolTip="Reload model and reset camera [F5]" Width="30" Height="30" Margin="0,0,2,0">
                        <Path Data="M14.5,9 A5.5,5.5 0 1,1 12.9,5.1 M14.5,3.5 L14.5,7 L11,7"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ButtonExport" ToolTip="Export current model to file [Ctrl+S]" Width="30" Height="30" Margin="0,0,2,0">
                        <Path Data="M8.5,2.5 L8.5,11 M5.5,8.5 L8.5,11.5 L11.5,8.5 M3,12.5 L3,13.5 A1.5,1.5 0 0,0 4.5,15 L12.5,15 A1.5,1.5 0 0,0 14,13.5 L14,12.5"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 3. External App SplitButton (38px, icon only) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonOpenExtApp" Width="24" Height="28" BorderThickness="0" Background="Transparent" ToolTip="Open with default external application [F7]">
                                <Path Data="M9,2 L13,2 L13,6 M13,2 L7,8 M11,9 L11,12 A1,1 0 0,1 10,13 L4,13 A1,1 0 0,1 3,12 L3,6 A1,1 0 0,1 4,5 L7,5"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="ButtonOpenExtAppDropdown" Width="12" Height="28" BorderThickness="0" Background="Transparent" ToolTip="Select application">
                                <Path Data="M0,0 L3,3 L6,0" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuExternalApps">
                                        <Separator/>
                                        <MenuItem x:Name="MenuSaveSnapshotPNG" Header="Save snapshot to PNG image [F6]"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 4. Compact Rotation Cluster X / Y / Z -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,7 A4.5,4.5 0 1,1 10.5,3.5 M12,1.5 L12,4.5 L9,4.5"
                                  Stroke="{DynamicResource WindowFore}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Margin="4,0,2,0" ToolTip="Rotate model around axis on 90 deg"/>
                            <Button x:Name="ButtonRotateX" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#F0777F" FontWeight="Bold" FontSize="11" Content="X" ToolTip="Rotate model around X axis on 90deg [W, S]"/>
                            <Button x:Name="ButtonRotateY" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#7FD97F" FontWeight="Bold" FontSize="11" Content="Y" ToolTip="Rotate model around Y axis on 90deg [Q, E]"/>
                            <Button x:Name="ButtonRotateZ" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#6FA8FF" FontWeight="Bold" FontSize="11" Content="Z" ToolTip="Rotate model around Z axis on 90deg [A, D]"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 5. Shading SplitButton -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ButtonWireframe" Width="24" Height="28" BorderThickness="0" Background="Transparent" ToolTip="Toggle Flat CAD Shaded / Wireframe [Ctrl+W]">
                                <Path Data="M7,1.5 L12.5,4.5 L12.5,9.5 L7,12.5 L1.5,9.5 L1.5,4.5 Z M1.5,4.5 L7,7.5 L12.5,4.5 M7,7.5 L7,12.5"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                      Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Button x:Name="ButtonShadingDropdown" Width="12" Height="28" BorderThickness="0" Background="Transparent" ToolTip="Shading options">
                                <Path Data="M0,0 L3,3 L6,0" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuShading">
                                        <MenuItem x:Name="MenuRecreateUnsmoothed" Header="Flat CAD Shaded (Default) [Ctrl+F]"/>
                                        <MenuItem x:Name="MenuWireframeOnly" Header="Wireframe Mode [Ctrl+W]"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuBacksideColor" Header="Highlight Faces Backside" IsCheckable="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 6. Camera Button -->
                    <ToggleButton x:Name="ButtonSelectCamera" Width="30" Height="30" ToolTip="Switch Perspective / Orthographic camera [F8]" Margin="0,0,2,0">
                        <Path Data="M2,3 L12,3 L12,11 L2,11 Z M2,3 L5,1 L15,1 L12,3 M15,1 L15,9 L12,11"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round"
                              Width="14" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 7. Ground Grid -->
                    <ToggleButton x:Name="ButtonGround" Width="30" Height="30" ToolTip="Show ground grid [P]" Margin="0,0,2,0">
                        <Path Data="M2,2 L14,2 L14,14 L2,14 Z M2,6 L14,6 M2,10 L14,10 M6,2 L6,14 M10,2 L10,14"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2"
                              Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- 8. Model Info HUD -->
                    <ToggleButton x:Name="ButtonShowModelInfo" Width="30" Height="30" ToolTip="Show model info HUD [I]" Margin="0,0,2,0">
                        <Path Data="M8,1 A7,7 0 1,1 7.99,1 M8,7 L8,11 M8,4.5 L8.01,4.5"
                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- 9. Overflow More Menu [ ⋯ ] -->
                    <Button x:Name="ButtonMore" Width="30" Height="30" ToolTip="More tools and settings" Margin="0,0,2,0">
                        <Path Data="M3,8 A1.5,1.5 0 1,1 2.99,8 M8,8 A1.5,1.5 0 1,1 7.99,8 M13,8 A1.5,1.5 0 1,1 12.99,8"
                              Fill="{DynamicResource WindowFore}"
                              Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuMore">
                                <MenuItem x:Name="MenuAxes" Header="Show XYZ axes lines [O]" IsCheckable="True"/>
                                <MenuItem x:Name="MenuCenterGC" Header="Turn camera at geometric center [C]"/>
                                <MenuItem x:Name="MenuCenterMC" Header="Turn camera at average center [M]"/>
                                <MenuItem x:Name="MenuFishEye" Header="Fish-Eye FOV mode" IsCheckable="True"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSwapNormals" Header="Swap Normals directions"/>
                                <MenuItem x:Name="MenuRemoveNormals" Header="Remove model normals"/>
                                <MenuItem x:Name="MenuFlipFaces" Header="Change vertices order"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSettings" Header="Settings…"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Legacy Material & Extra Controls (Hidden, preserving settings binding compatibility) -->
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="ButtonSaveImage"/>
                        <Button x:Name="ButtonCenterCameraAtModelGC"/>
                        <Button x:Name="ButtonCenterCameraAtModelMC"/>
                        <ToggleButton x:Name="ButtonFishEyeFOV"/>
                        <ToggleButton x:Name="ButtonAxes"/>
                        <Button x:Name="ButtonSwapNormals"/>
                        <Button x:Name="ButtonRemoveNormals"/>
                        <Button x:Name="ButtonChangeVerticesOrder"/>
                        <Button x:Name="ButtonRecreateUnsmoothed"/>
                        <Button x:Name="ButtonSettings"/>
                        <ToggleButton x:Name="ButtonDiffuseMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonSpecularMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonEmissiveMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonBacksideDiffuseMaterial" IsChecked="False"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Center: Clean Bare Filename -->
                <TextBlock x:Name="textBlockTitle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Solid Model Browser" Foreground="{DynamicResource WindowFore}" Opacity="0.85"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                <!-- Right: Theme & Windows 11 Chrome Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ButtonChangeTheme" Width="30" Height="30" ToolTip="Switch Light / Dark Theme">
                        <Path Data="M8,1 A7,7 0 1,0 15,8 A5.5,5.5 0 0,1 8,1 Z"
                              Fill="{DynamicResource WindowFore}" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel x:Name="StackPanelSystemButtons" Orientation="Horizontal">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>
                        <Button x:Name="ButtonMinimize" Width="30" Height="30" ToolTip="Minimize">
                            <Path Data="M2,7 L12,7" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="ButtonMaximize" Width="30" Height="30" ToolTip="Maximize">
                            <Path Data="M2,2 L12,2 L12,12 L2,12 Z" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="ButtonClose" Width="30" Height="30" ToolTip="Close">
                            <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- MAIN WORKSPACE: SIDEBAR + VIEWPORT + SLICER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilePanelColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Opaque File Navigation Panel (Hidden by default, zero startup flicker) -->
                <local:FileNavigationPanel x:Name="filePanel" Visibility="Collapsed" Background="{DynamicResource PanelBack}" Foreground="{DynamicResource WindowFore}" Padding="0,0,5,0" Grid.Column="0"/>

                <GridSplitter x:Name="FilePanelSplitter" Visibility="Collapsed" Background="{DynamicResource TransparentHandle}" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeBehavior="CurrentAndNext"/>

                <!-- Model Info Floating HUD Card (Toggled via I key) -->
                <Border x:Name="infoContainer" Margin="16" CornerRadius="6" Background="{DynamicResource InfoPanel}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="textBlockInfo" FontSize="11" Foreground="{DynamicResource WindowFore}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Progress Bar Container -->
                <Border x:Name="borderProgressContainer" Visibility="Hidden" Width="108" Height="20" CornerRadius="4" BorderThickness="1" Padding="2" BorderBrush="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="borderProgress" Width="50" Height="16" CornerRadius="4" BorderThickness="1" Background="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>

                <!-- Z-Height Slicer (Vertical on Right, Circular Thumb) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Margin="8,16,14,16">
                    <Slider x:Name="sliderSliceHeight" Orientation="Vertical" SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
