<Window x:Class="SolidModelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Icon="app.ico"
        Title="Solid Model Browser" Height="600" Width="800" MinWidth="600" MinHeight="400">

    <Grid>
        <local:Scene x:Name="scene" />

        <DockPanel x:Name="MainContainer">

            <!-- MODERN WINDOW TOOLBAR & TITLEBAR -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4" MouseDown="Handler_MouseDown" Background="{DynamicResource TransparentHandle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Toolbar -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2,0,2">
                    <!-- 1. Sidebar Toggle (coolicons window-sidebar-duotone-round 20x20) -->
                    <ToggleButton x:Name="ButtonToggleFilePanel" ToolTip="Toggle File Browser [Tab]" Width="30" Height="30" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 8H9v12H7a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M3 8a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4zm0 0h18M9 8v12" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 2. File Actions -->
                    <Button x:Name="ButtonReloadModel" ToolTip="Reload Model [F5]" Width="30" Height="30" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4.384 12a7.617 7.617 0 1 1 15.233 0a7.617 7.617 0 1 1-15.233 0" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M19 9A7.616 7.616 0 0 0 5 9m6 0H5V3m0 12a7.616 7.616 0 0 0 14 0m-6 0h6v6" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ButtonExport" ToolTip="Export Model [Ctrl+E]" Width="30" Height="30" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 16.313a2 2 0 0 1-1.114 1.793l-7 3.457a2 2 0 0 1-1.772 0l-7-3.457A2 2 0 0 1 3 16.313V7.687a2 2 0 0 1 1.114-1.793l7-3.457a2 2 0 0 1 1.772 0l7 3.457A2 2 0 0 1 21 7.687Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M21 12V7.687a2 2 0 0 0-1.114-1.793l-3.5-1.729m0 0L13 2.408a2 2 0 0 0-1.772 0l-7 3.457A2 2 0 0 0 3 7.687v8.626a2 2 0 0 0 1.114 1.793l7 3.457a2 2 0 0 0 1.772 0V10.89M3.32 6.602L12 10.89l8.68-4.287M18 21l3-3l-3-3m3 3h-6" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 3. External App SplitButton (coolicons share-duotone-round 20x20) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonOpenExtApp" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="28" ToolTip="Open in External App [F7]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4 14a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                        <Path Data="M8 10a4 4 0 0 0-4 4v3a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-3a4 4 0 0 0-4-4m-1-4l-3-3l-3 3m3-3v10" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonOpenExtAppDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Select Application" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuExternalApps">
                                        <Separator/>
                                        <MenuItem x:Name="MenuSaveSnapshotPNG" Header="Save PNG Snapshot [F6]"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 4. Shading SplitButton (3 States: Solid [bulk-round], Solid+Wire [duotone-round], Wire [round]) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonWireframe" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="28" ToolTip="Toggle Shading [W]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Viewbox Width="20" Height="20">
                                    <Grid Width="24" Height="24">
                                        <!-- 1. Solid: duotone (contours + accent fill) -->
                                        <Canvas x:Name="CanvasShadingSolid" Width="24" Height="24" Visibility="Visible">
                                            <Path Data="M21 16.313a2 2 0 0 1-1.114 1.793l-7 3.457a2 2 0 0 1-1.772 0l-7-3.457A2 2 0 0 1 3 16.313V7.687a2 2 0 0 1 1.114-1.793l7-3.457a2 2 0 0 1 1.772 0l7 3.457A2 2 0 0 1 21 7.687Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                            <Path Data="M21 12v4.313a2 2 0 0 1-1.114 1.793l-7 3.457a2 2 0 0 1-1.772 0l-7-3.457A2 2 0 0 1 3 16.313V7.687a2 2 0 0 1 1.114-1.793l7-3.457a2 2 0 0 1 1.772 0l7 3.457A2 2 0 0 1 21 7.687zM3.32 6.602L12 10.89l8.68-4.287M12 10.89v10.88" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <!-- 2. Solid + Wire: bulk variation (showing solid + ribs) -->
                                        <Canvas x:Name="CanvasShadingSolidAndWireframe" Width="24" Height="24" Visibility="Collapsed">
                                            <Path Data="M22 7.687v8.626a3 3 0 0 1-1.672 2.69l-7 3.456a3 3 0 0 1-2.656 0l-7-3.456A3 3 0 0 1 2 16.313V7.687c0-1.141.648-2.184 1.672-2.69l7-3.456a3 3 0 0 1 2.656 0l7 3.456A3 3 0 0 1 22 7.687" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                            <Path Data="m12 9.774l8.237-4.069a1.002 1.002 0 0 1 .886 1.794L13 11.51v10.259a1 1 0 0 1-2 0V11.51L2.877 7.499a1.002 1.002 0 0 1 .886-1.794Z" Fill="{DynamicResource WindowFore}"/>
                                        </Canvas>
                                        <!-- 3. Wireframe: box-round (outlines only, no fill) -->
                                        <Canvas x:Name="CanvasShadingWireframe" Width="24" Height="24" Visibility="Collapsed">
                                            <Path Data="M21 12v4.313a2 2 0 0 1-1.114 1.793l-7 3.457a2 2 0 0 1-1.772 0l-7-3.457A2 2 0 0 1 3 16.313V7.687a2 2 0 0 1 1.114-1.793l7-3.457a2 2 0 0 1 1.772 0l7 3.457A2 2 0 0 1 21 7.687zM3.32 6.602L12 10.89l8.68-4.287M12 10.89v10.88" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonShadingDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Shading Options" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuShading">
                                        <MenuItem x:Name="MenuSolid" Header="Solid" InputGestureText="1" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuSolidAndWireframe" Header="Solid + Wireframe" InputGestureText="2" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuWireframeOnly" Header="Wireframe" InputGestureText="3" IsCheckable="True"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuRecreateUnsmoothed" Header="Smooth Shading" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuBacksideColor" Header="Show Backfaces" IsCheckable="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 5. Camera Projection Button (Perspective / Ortho / Fisheye) -->
                    <Button x:Name="ButtonSelectCamera" Width="30" Height="30" ToolTip="Switch Camera Projection [F8]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Grid Width="24" Height="24">
                                <!-- Perspective: video-duotone-round -->
                                <Canvas x:Name="CanvasCameraPerspective" Width="24" Height="24" Visibility="Visible">
                                    <Path Data="M3 10a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                    <Path Data="M3 10a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Zm12 0l2-1c1.838-.919 4 .162 4 2v2c0 1.838-2.162 2.919-4 2l-2-1" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                                <!-- Orthographic: camera-duotone-round -->
                                <Canvas x:Name="CanvasCameraOrtho" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m7 7l2-2c.64-.64 1.36-1 2-1h2c.64 0 1.36.36 2 1l2 2a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4m2 6a3 3 0 1 0 6 0a3 3 0 0 0-6 0" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                    <Path Data="m7 7l2-2c.64-.64 1.36-1 2-1h2c.64 0 1.36.36 2 1l2 2a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4m2 6a3 3 0 1 0 6 0a3 3 0 0 0-6 0" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                                <!-- Fisheye: aperture-duotone-round -->
                                <Canvas x:Name="CanvasCameraFishEye" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="M3 12a9 9 0 0 1 9-9a9 9 0 0 1 9 9a9 9 0 0 1-9 9a9 9 0 0 1-9-9m10-5l-.008.004l-.003.001l-5.978 2.989l-.004.003L7 10v4l.008.006l3.982 2.987l.003.002L11 17l.008-.004l.003-.001l5.978-2.989l.004-.003L17 14v-4l-3.99-2.993l-.004-.002Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                    <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0m0 0l10-5M9 4l8 6m0-5v9m4-2l-10 5m4 3l-8-6m0 5v-9" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Button>

                    <!-- 6. Camera Centering SplitButton (coolicons target-duotone-round 20x20) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonCenterCamera" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="28" ToolTip="Center Camera on Model [F]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 12a9 9 0 0 1 9-9a9 9 0 0 1 9 9a9 9 0 0 1-9 9a9 9 0 0 1-9-9" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                        <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0m4 0a5 5 0 0 1 10 0m0 0a5 5 0 0 1-10 0m5 0h.01" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonCenterDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Centering Options" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuCenterCamera">
                                        <MenuItem x:Name="MenuCenterMC" Header="Center on Average" InputGestureText="M"/>
                                        <MenuItem x:Name="MenuCenterGC" Header="Center on Geometry" InputGestureText="C"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 7. Ground Grid (coolicons grid-alt-duotone-round 20x20) -->
                    <ToggleButton x:Name="ButtonGround" Width="30" Height="30" ToolTip="Toggle Ground Grid [P]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M8 4a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V8a4 4 0 0 0-4-4Zm-4 5h16M4 15h16M9 4v16m6-16v16" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 8. Model Info HUD (coolicons tags-duotone-round 20x20) -->
                    <ToggleButton x:Name="ButtonShowModelInfo" Width="30" Height="30" ToolTip="Toggle Model Info [I]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 6h1c1.041 0 2.236.237 3 1l2 2a4.242 4.242 0 1 1-6 6l-2-2c-.763-.764-1-1.959-1-3V9a3 3 0 0 1 3-3" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M6 6h1c1.28 0 2.36.36 3 1l2 2a4.243 4.243 0 0 1-6 6l-2-2c-.64-.64-1-1.72-1-3V9a3 3 0 0 1 3-3m1 4h.01M15 6l3 3a4.243 4.243 0 0 1 0 6l-3 3" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 9. Overflow More Menu [ ⋯ ] (coolicons more_horizontal-round 20x20) -->
                    <Button x:Name="ButtonMore" Width="30" Height="30" ToolTip="More Tools" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 12a1 1 0 1 0 2 0a1 1 0 0 0-2 0m6 0a1 1 0 1 0 2 0a1 1 0 0 0-2 0m6 0a1 1 0 1 0 2 0a1 1 0 0 0-2 0" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuMore">
                                <MenuItem x:Name="MenuRotateX" Header="Rotate X 90°" InputGestureText="X"/>
                                <MenuItem x:Name="MenuRotateY" Header="Rotate Y 90°" InputGestureText="Y"/>
                                <MenuItem x:Name="MenuRotateZ" Header="Rotate Z 90°" InputGestureText="Z"/>
                                <Separator/>
                                <MenuItem x:Name="MenuAxes" Header="Ground Axes" InputGestureText="O" IsCheckable="True"/>
                                <MenuItem x:Name="MenuFishEye" Header="Fisheye Projection"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSwapNormals" Header="Invert Normals"/>
                                <MenuItem x:Name="MenuRemoveNormals" Header="Delete Normals"/>
                                <MenuItem x:Name="MenuFlipFaces" Header="Flip Faces"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSettings" Header="Settings..."/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Legacy Material & Extra Controls (Hidden, preserving settings binding compatibility) -->
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="ButtonSaveImage"/>
                        <Button x:Name="ButtonCenterCameraAtModelGC"/>
                        <Button x:Name="ButtonCenterCameraAtModelMC"/>
                        <ToggleButton x:Name="ButtonFishEyeFOV"/>
                        <ToggleButton x:Name="ButtonAxes"/>
                        <Button x:Name="ButtonSwapNormals"/>
                        <Button x:Name="ButtonRemoveNormals"/>
                        <Button x:Name="ButtonChangeVerticesOrder"/>
                        <Button x:Name="ButtonRecreateUnsmoothed"/>
                        <Button x:Name="ButtonSettings"/>
                        <ToggleButton x:Name="ButtonDiffuseMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonSpecularMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonEmissiveMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonBacksideDiffuseMaterial" IsChecked="False"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Center: Clean Bare Filename -->
                <TextBlock x:Name="textBlockTitle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Solid Model Browser" Foreground="{DynamicResource WindowFore}" Opacity="0.85"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                <!-- Right: Theme & Windows 11 Chrome Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ButtonChangeTheme" Width="30" Height="30" ToolTip="Switch Theme" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9 9a4.27 4.27 0 1 0 6 6a6 6 0 1 1-6-6" Fill="{DynamicResource ToolbarIconAccent}" Opacity="{DynamicResource ToolbarIconAccentOpacity}"/>
                                <Path Data="M15 15a6 6 0 1 1-6-6a4.269 4.269 0 1 0 6 6m-1.974-5.82a3 3 0 0 1 1.793 1.794M19 12h2m-9-7V3m4.95 4.05l1.414-1.414" Stroke="{DynamicResource WindowFore}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <StackPanel x:Name="StackPanelSystemButtons" Orientation="Horizontal">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>
                        <Button x:Name="ButtonMinimize" Width="30" Height="30" ToolTip="Minimize" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0,6 H10" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="ButtonMaximize" Width="30" Height="30" ToolTip="Maximize" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="ButtonClose" Width="30" Height="30" ToolTip="Close" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- MAIN WORKSPACE: SIDEBAR + VIEWPORT + SLICER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilePanelColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Opaque File Navigation Panel (Hidden by default, zero startup flicker) -->
                <local:FileNavigationPanel x:Name="filePanel" Visibility="Collapsed" Background="{DynamicResource PanelBack}" Foreground="{DynamicResource WindowFore}" Padding="0,0,5,0" Grid.Column="0"/>

                <GridSplitter x:Name="FilePanelSplitter" Visibility="Collapsed" Background="{DynamicResource TransparentHandle}" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeBehavior="CurrentAndNext"/>

                <!-- Model Info Floating HUD Card (Toggled via I key, cleared from right slider) -->
                <Border x:Name="infoContainer" Margin="16,16,44,16" CornerRadius="6" Background="{DynamicResource InfoPanel}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="14,10" SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="textBlockInfo" FontSize="11" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource WindowFore}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Progress Bar Container -->
                <Border x:Name="borderProgressContainer" Visibility="Hidden" Width="108" Height="20" CornerRadius="4" BorderThickness="1" Padding="2" BorderBrush="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="borderProgress" Width="50" Height="16" CornerRadius="4" BorderThickness="1" Background="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>

                <!-- Z-Height Slicer (Vertical on Right, Circular Thumb) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Margin="8,24,18,24">
                    <Slider x:Name="sliderSliceHeight" Orientation="Vertical" SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
