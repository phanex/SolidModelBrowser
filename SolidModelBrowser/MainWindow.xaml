<Window x:Class="SolidModelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Icon="app.ico"
        Title="Solid Model Browser" Height="600" Width="800" MinWidth="600" MinHeight="400">

    <Grid>
        <local:Scene x:Name="scene" />

        <DockPanel x:Name="MainContainer">

            <!-- MODERN WINDOW TOOLBAR & TITLEBAR -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4" MouseDown="Handler_MouseDown" Background="{DynamicResource TransparentHandle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Toolbar -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2,0,2">
                    <!-- 1. Sidebar Toggle (coolicons duotone sidebar 24x24) -->
                    <ToggleButton x:Name="ButtonToggleFilePanel" ToolTip="Toggle File Browser [Tab]" Width="32" Height="32" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,4 H8 V20 H3 Z" Fill="{DynamicResource WindowFore}" Opacity="0.35"/>
                            <Path Data="M3,4 H21 A1,1 0 0,1 22,5 V19 A1,1 0 0,1 21,20 H3 A1,1 0 0,1 2,19 V5 A1,1 0 0,1 3,4 Z M9,6 V18 H20 V6 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 2. File Actions -->
                    <Button x:Name="ButtonReloadModel" ToolTip="Reload Model [F5]" Width="32" Height="32" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,4 V1 L7,5.5 L12,10 V7 C15.31,7 18,9.69 18,13 C18,14.01 17.75,14.97 17.3,15.8 L18.76,17.26 C19.54,16.03 20,14.57 20,13 C20,8.58 16.42,5 12,5 Z M12,19 C8.69,19 6,16.31 6,13 C6,11.99 6.25,11.03 6.7,10.2 L5.24,8.74 C4.46,9.97 4,11.43 4,13 C4,17.42 7.58,21 12,21 V24 L17,19.5 L12,15 V19 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="ButtonExport" ToolTip="Export Model [Ctrl+E]" Width="32" Height="32" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,16 L6,10 H9.5 V3 H14.5 V10 H18 Z M4,18 H20 V20 H4 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </Button>

                    <!-- 3. External App SplitButton (coolicons 24x24) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonOpenExtApp" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="30" ToolTip="Open in External App [F7]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M19,19 H5 V5 H11 V3 H5 A2,2 0 0,0 3,5 V19 A2,2 0 0,0 5,21 H19 A2,2 0 0,0 21,19 V13 H19 Z M14,3 V5 H17.59 L8.76,13.83 L10.17,15.24 L19,6.41 V10 H21 V3 Z"
                                          Fill="{DynamicResource WindowFore}"/>
                                </Canvas>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonOpenExtAppDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="30" ToolTip="Select Application" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuExternalApps">
                                        <Separator/>
                                        <MenuItem x:Name="MenuSaveSnapshotPNG" Header="Save PNG Snapshot [F6]"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 4. Compact Rotation Cluster X / Y / Z -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="14" Height="14" Margin="4,0,2,0" SnapsToDevicePixels="True">
                                <Path Data="M11,6 A4.5,4.5 0 1,1 9.5,2.5 M11,1 L11,4 L8,4"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <Button x:Name="ButtonRotateX" Width="20" Height="28" BorderThickness="0" Background="Transparent" Foreground="#F0777F" FontWeight="Bold" FontSize="11" Content="X" ToolTip="Rotate X [X]"/>
                            <Button x:Name="ButtonRotateY" Width="20" Height="28" BorderThickness="0" Background="Transparent" Foreground="#7FD97F" FontWeight="Bold" FontSize="11" Content="Y" ToolTip="Rotate Y [Y]"/>
                            <Button x:Name="ButtonRotateZ" Width="20" Height="28" BorderThickness="0" Background="Transparent" Foreground="#6FA8FF" FontWeight="Bold" FontSize="11" Content="Z" ToolTip="Rotate Z [Z]"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 5. Shading SplitButton (coolicons 3D Cube 24x24 duotone) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonWireframe" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="30" ToolTip="Toggle Shading [W]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PathShadingSolidFace" Data="M12,2.5 L21,7.5 L12,12.5 L3,7.5 Z" Fill="{DynamicResource WindowFore}" Opacity="0.35"/>
                                    <Path Data="M12,2.5 L21,7.5 V16.5 L12,21.5 L3,16.5 V7.5 Z M3,7.5 L12,12.5 L21,7.5 M12,12.5 V21.5"
                                          Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonShadingDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="30" ToolTip="Shading Options" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuShading">
                                        <MenuItem x:Name="MenuSolid" Header="Solid" InputGestureText="1" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuSolidAndWireframe" Header="Solid + Wireframe" InputGestureText="2" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuWireframeOnly" Header="Wireframe" InputGestureText="3" IsCheckable="True"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuRecreateUnsmoothed" Header="Smooth Shading" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuBacksideColor" Header="Show Backfaces" IsCheckable="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 6. Camera Projection Button (coolicons video camera 24x24) -->
                    <Button x:Name="ButtonSelectCamera" Width="32" Height="32" ToolTip="Switch Camera Projection [F8]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas x:Name="CanvasCameraIcon" Width="24" Height="24">
                            <Path x:Name="PathCameraPerspective" Data="M3,6.5 H13 A1.5,1.5 0 0,1 14.5,8 V16 A1.5,1.5 0 0,1 13,17.5 H3 A1.5,1.5 0 0,1 1.5,16 V8 A1.5,1.5 0 0,1 3,6.5 Z M15,10.5 L21.5,6.5 V17.5 L15,13.5 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </Button>

                    <!-- 7. Camera Centering SplitButton (coolicons focus 24x24) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonCenterCamera" Style="{StaticResource SplitButtonLeftStyle}" Width="28" Height="30" ToolTip="Center Camera on Model [F]" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5,2.5 H9 V4.5 H5 V8.5 H3 V4.5 A2,2 0 0,1 5,2.5 Z M19,2.5 A2,2 0 0,1 21,4.5 V8.5 H19 V4.5 H15 V2.5 Z M5,19.5 V15.5 H3 V19.5 A2,2 0 0,0 5,21.5 H9 V19.5 Z M19,19.5 H15 V21.5 H19 A2,2 0 0,0 21,19.5 V15.5 H19 Z M12,8 A4,4 0 1,0 12,16 A4,4 0 0,0 12,8 Z"
                                          Fill="{DynamicResource WindowFore}"/>
                                </Canvas>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonCenterDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="30" ToolTip="Centering Options" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas Width="8" Height="6">
                                    <Path Data="M0.5,1.5 L4,5 L7.5,1.5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuCenterCamera">
                                        <MenuItem x:Name="MenuCenterMC" Header="Center on Average" InputGestureText="M"/>
                                        <MenuItem x:Name="MenuCenterGC" Header="Center on Geometry" InputGestureText="C"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 8. Ground Grid (coolicons grid 24x24) -->
                    <ToggleButton x:Name="ButtonGround" Width="32" Height="32" ToolTip="Toggle Ground Grid [P]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,3 H21 A1,1 0 0,1 22,4 V20 A1,1 0 0,1 21,21 H3 A1,1 0 0,1 2,20 V4 A1,1 0 0,1 3,3 Z M8,5 H4 V9 H8 Z M14,5 H10 V9 H14 Z M20,5 H16 V9 H20 Z M8,11 H4 V15 H8 Z M14,11 H10 V15 H14 Z M20,11 H16 V15 H20 Z M8,17 H4 V19 H8 Z M14,17 H10 V19 H14 Z M20,17 H16 V19 H20 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </ToggleButton>

                    <!-- 9. Model Info HUD (coolicons info 24x24) -->
                    <ToggleButton x:Name="ButtonShowModelInfo" Width="32" Height="32" ToolTip="Toggle Model Info [I]" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 0,0 12,2 Z M12,6.5 A1.5,1.5 0 1,1 12,9.5 A1.5,1.5 0 0,1 12,6.5 Z M13.5,17.5 H10.5 V11.5 H13.5 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </ToggleButton>

                    <!-- 10. Overflow More Menu [ ⋯ ] (coolicons more_horizontal 24x24) -->
                    <Button x:Name="ButtonMore" Width="32" Height="32" ToolTip="More Tools" Margin="0,0,2,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,12 A2,2 0 1,1 3,10 A2,2 0 0,1 5,12 Z M14,12 A2,2 0 1,1 12,10 A2,2 0 0,1 14,12 Z M23,12 A2,2 0 1,1 21,10 A2,2 0 0,1 23,12 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuMore">
                                <MenuItem x:Name="MenuAxes" Header="Ground Axes" InputGestureText="O" IsCheckable="True"/>
                                <MenuItem x:Name="MenuFishEye" Header="Fisheye Projection"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSwapNormals" Header="Invert Normals"/>
                                <MenuItem x:Name="MenuRemoveNormals" Header="Delete Normals"/>
                                <MenuItem x:Name="MenuFlipFaces" Header="Flip Faces"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSettings" Header="Settings..."/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Legacy Material & Extra Controls (Hidden, preserving settings binding compatibility) -->
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="ButtonSaveImage"/>
                        <Button x:Name="ButtonCenterCameraAtModelGC"/>
                        <Button x:Name="ButtonCenterCameraAtModelMC"/>
                        <ToggleButton x:Name="ButtonFishEyeFOV"/>
                        <ToggleButton x:Name="ButtonAxes"/>
                        <Button x:Name="ButtonSwapNormals"/>
                        <Button x:Name="ButtonRemoveNormals"/>
                        <Button x:Name="ButtonChangeVerticesOrder"/>
                        <Button x:Name="ButtonRecreateUnsmoothed"/>
                        <Button x:Name="ButtonSettings"/>
                        <ToggleButton x:Name="ButtonDiffuseMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonSpecularMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonEmissiveMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonBacksideDiffuseMaterial" IsChecked="False"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Center: Clean Bare Filename -->
                <TextBlock x:Name="textBlockTitle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Solid Model Browser" Foreground="{DynamicResource WindowFore}" Opacity="0.85"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                <!-- Right: Theme & Windows 11 Chrome Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ButtonChangeTheme" Width="32" Height="32" ToolTip="Switch Theme" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 0,0 12,2 Z M12,20 V4 A8,8 0 0,1 12,20 Z"
                                  Fill="{DynamicResource WindowFore}"/>
                        </Canvas>
                    </Button>
                    <StackPanel x:Name="StackPanelSystemButtons" Orientation="Horizontal">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>
                        <Button x:Name="ButtonMinimize" Width="30" Height="30" ToolTip="Minimize" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0,6 H10" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="ButtonMaximize" Width="30" Height="30" ToolTip="Maximize" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="ButtonClose" Width="30" Height="30" ToolTip="Close" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Canvas Width="10" Height="10">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.0"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- MAIN WORKSPACE: SIDEBAR + VIEWPORT + SLICER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilePanelColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Opaque File Navigation Panel (Hidden by default, zero startup flicker) -->
                <local:FileNavigationPanel x:Name="filePanel" Visibility="Collapsed" Background="{DynamicResource PanelBack}" Foreground="{DynamicResource WindowFore}" Padding="0,0,5,0" Grid.Column="0"/>

                <GridSplitter x:Name="FilePanelSplitter" Visibility="Collapsed" Background="{DynamicResource TransparentHandle}" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeBehavior="CurrentAndNext"/>

                <!-- Model Info Floating HUD Card (Toggled via I key, cleared from right slider) -->
                <Border x:Name="infoContainer" Margin="16,16,44,16" CornerRadius="6" Background="{DynamicResource InfoPanel}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="14,10" SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="textBlockInfo" FontSize="11" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource WindowFore}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Progress Bar Container -->
                <Border x:Name="borderProgressContainer" Visibility="Hidden" Width="108" Height="20" CornerRadius="4" BorderThickness="1" Padding="2" BorderBrush="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="borderProgress" Width="50" Height="16" CornerRadius="4" BorderThickness="1" Background="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>

                <!-- Z-Height Slicer (Vertical on Right, Circular Thumb) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Margin="8,24,18,24">
                    <Slider x:Name="sliderSliceHeight" Orientation="Vertical" SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
