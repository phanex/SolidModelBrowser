<Window x:Class="SolidModelBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidModelBrowser"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Icon="app.ico"
        Title="Solid Model Browser" Height="600" Width="800" MinWidth="600" MinHeight="400">

    <Grid>
        <local:Scene x:Name="scene" />

        <DockPanel x:Name="MainContainer">

            <!-- MODERN WINDOW TOOLBAR & TITLEBAR -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4" MouseDown="Handler_MouseDown" Background="{DynamicResource TransparentHandle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Toolbar -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2,0,2">
                    <!-- 1. Sidebar Toggle (Duotone) -->
                    <ToggleButton x:Name="ButtonToggleFilePanel" ToolTip="Toggle File Browser [Tab]" Width="30" Height="30" Margin="0,0,2,0">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="4.5" Height="12" RadiusX="1" RadiusY="1" Fill="{DynamicResource WindowFore}" Opacity="0.3"/>
                                <Path Data="M2,2 L14,2 A1.5,1.5 0 0,1 15.5,3.5 L15.5,12.5 A1.5,1.5 0 0,1 14,14 L2,14 A1.5,1.5 0 0,1 0.5,12.5 L0.5,3.5 A1.5,1.5 0 0,1 2,2 Z M6,2 L6,14"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 2. File Actions -->
                    <Button x:Name="ButtonReloadModel" ToolTip="Reload Model [F5]" Width="30" Height="30" Margin="0,0,2,0">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M13.5,8 A5.5,5.5 0 1,1 11.9,4.1 M13.5,2.5 L13.5,6 L10,6"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ButtonExport" ToolTip="Export Model [Ctrl+E]" Width="30" Height="30" Margin="0,0,2,0">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,11 L2,13.5 A1.5,1.5 0 0,0 3.5,15 L12.5,15 A1.5,1.5 0 0,0 14,13.5 L14,11"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M8,1.5 L8,10.5 M5,7.5 L8,10.5 L11,7.5"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 3. External App SplitButton (38px, icon only) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonOpenExtApp" Style="{StaticResource SplitButtonLeftStyle}" Width="24" Height="28" ToolTip="Open in External App [F7]">
                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M10,2 L14,2 L14,6 M14,2 L7.5,8.5 M12,9.5 L12,13 A1.5,1.5 0 0,1 10.5,14.5 L3.5,14.5 A1.5,1.5 0 0,1 2,13 L2,6 A1.5,1.5 0 0,1 3.5,4.5 L7,4.5"
                                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonOpenExtAppDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Select Application">
                                <Viewbox Width="8" Height="6" Stretch="Uniform">
                                    <Path Data="M0.5,1 L4,4.5 L7.5,1" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuExternalApps">
                                        <Separator/>
                                        <MenuItem x:Name="MenuSaveSnapshotPNG" Header="Save PNG Snapshot [F6]"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 4. Compact Rotation Cluster X / Y / Z -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="4,0,2,0">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M12,7 A4.5,4.5 0 1,1 10.5,3.5 M12,1.5 L12,4.5 L9,4.5"
                                          Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <Button x:Name="ButtonRotateX" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#F0777F" FontWeight="Bold" FontSize="11" Content="X" ToolTip="Rotate X [X]"/>
                            <Button x:Name="ButtonRotateY" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#7FD97F" FontWeight="Bold" FontSize="11" Content="Y" ToolTip="Rotate Y [Y]"/>
                            <Button x:Name="ButtonRotateZ" Width="20" Height="26" BorderThickness="0" Background="Transparent" Foreground="#6FA8FF" FontWeight="Bold" FontSize="11" Content="Z" ToolTip="Rotate Z [Z]"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 5. Shading SplitButton (Duotone) -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonWireframe" Style="{StaticResource SplitButtonLeftStyle}" Width="24" Height="28" ToolTip="Toggle Shading [W]">
                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                    <Canvas Width="16" Height="16">
                                        <Path x:Name="PathShadingSolidFace" Data="M8,1.5 L14,4.8 L8,8.2 L2,4.8 Z" Fill="{DynamicResource WindowFore}" Opacity="0.35"/>
                                        <Path Data="M8,1.5 L14,4.8 L14,11.2 L8,14.5 L2,11.2 L2,4.8 Z M2,4.8 L8,8.2 L14,4.8 M8,8.2 L8,14.5"
                                              Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonShadingDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Shading Options">
                                <Viewbox Width="8" Height="6" Stretch="Uniform">
                                    <Path Data="M0.5,1 L4,4.5 L7.5,1" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuShading">
                                        <MenuItem x:Name="MenuSolid" Header="Solid [1]" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuSolidAndWireframe" Header="Solid + Wireframe [2]" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuWireframeOnly" Header="Wireframe [3]" IsCheckable="True"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuRecreateUnsmoothed" Header="Smooth Shading" IsCheckable="True"/>
                                        <MenuItem x:Name="MenuBacksideColor" Header="Show Backfaces" IsCheckable="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 6. Camera Projection Button -->
                    <Button x:Name="ButtonSelectCamera" Width="30" Height="30" ToolTip="Switch Camera Projection [F8]" Margin="0,0,2,0">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas x:Name="CanvasCameraIcon" Width="16" Height="16">
                                <Path x:Name="PathCameraPerspective" Data="M2,5 L8,2 L14,5 L14,12 L8,15 L2,12 Z M2,5 L8,8 L14,5 M8,8 L8,15" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 7. Camera Centering SplitButton -->
                    <Border Background="{DynamicResource ButtonBack}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonCenterCamera" Style="{StaticResource SplitButtonLeftStyle}" Width="24" Height="28" ToolTip="Center Camera [C]">
                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M8,1.5 L8,4.5 M8,11.5 L8,14.5 M1.5,8 L4.5,8 M11.5,8 L14.5,8" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="8" Height="8" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2"/>
                                        <Ellipse Canvas.Left="7" Canvas.Top="7" Width="2" Height="2" Fill="{DynamicResource WindowFore}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Separator}" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonCenterDropdown" Style="{StaticResource SplitButtonRightStyle}" Width="14" Height="28" ToolTip="Centering Options">
                                <Viewbox Width="8" Height="6" Stretch="Uniform">
                                    <Path Data="M0.5,1 L4,4.5 L7.5,1" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuCenterCamera">
                                        <MenuItem x:Name="MenuCenterMC" Header="Center on Average [M]"/>
                                        <MenuItem x:Name="MenuCenterGC" Header="Center on Geometry [C]"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>

                    <!-- 8. Ground Grid -->
                    <ToggleButton x:Name="ButtonGround" Width="30" Height="30" ToolTip="Toggle Ground Grid [P]" Margin="0,0,2,0">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M1.5,1.5 L14.5,1.5 L14.5,14.5 L1.5,14.5 Z M1.5,6 L14.5,6 M1.5,10.5 L14.5,10.5 M6,1.5 L6,14.5 M10.5,1.5 L10.5,14.5"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.1"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 9. Model Info HUD -->
                    <ToggleButton x:Name="ButtonShowModelInfo" Width="30" Height="30" ToolTip="Toggle Model Info [I]" Margin="0,0,2,0">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M3,2 L13,2 A1,1 0 0,1 14,3 L14,13 A1,1 0 0,1 13,14 L3,14 A1,1 0 0,1 2,13 L2,3 A1,1 0 0,1 3,2 Z"
                                      Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                <Path Data="M5,5 L11,5" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45"/>
                                <Path Data="M5,8 L11,8 M5,11 L8.5,11" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <!-- 10. Overflow More Menu [ ⋯ ] -->
                    <Button x:Name="ButtonMore" Width="30" Height="30" ToolTip="More Tools" Margin="0,0,2,0">
                        <Viewbox Width="15" Height="15" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="2" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{DynamicResource WindowFore}"/>
                                <Ellipse Canvas.Left="6.75" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{DynamicResource WindowFore}"/>
                                <Ellipse Canvas.Left="11.5" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{DynamicResource WindowFore}"/>
                            </Canvas>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuMore">
                                <MenuItem x:Name="MenuAxes" Header="Show Axes [O]" IsCheckable="True"/>
                                <MenuItem x:Name="MenuFishEye" Header="Switch to Fisheye"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSwapNormals" Header="Invert Normals"/>
                                <MenuItem x:Name="MenuRemoveNormals" Header="Delete Normals"/>
                                <MenuItem x:Name="MenuFlipFaces" Header="Flip Faces"/>
                                <Separator/>
                                <MenuItem x:Name="MenuSettings" Header="Open Settings…"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Legacy Material & Extra Controls (Hidden, preserving settings binding compatibility) -->
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="ButtonSaveImage"/>
                        <Button x:Name="ButtonCenterCameraAtModelGC"/>
                        <Button x:Name="ButtonCenterCameraAtModelMC"/>
                        <ToggleButton x:Name="ButtonFishEyeFOV"/>
                        <ToggleButton x:Name="ButtonAxes"/>
                        <Button x:Name="ButtonSwapNormals"/>
                        <Button x:Name="ButtonRemoveNormals"/>
                        <Button x:Name="ButtonChangeVerticesOrder"/>
                        <Button x:Name="ButtonRecreateUnsmoothed"/>
                        <Button x:Name="ButtonSettings"/>
                        <ToggleButton x:Name="ButtonDiffuseMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonSpecularMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonEmissiveMaterial" IsChecked="True"/>
                        <ToggleButton x:Name="ButtonBacksideDiffuseMaterial" IsChecked="False"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Center: Clean Bare Filename -->
                <TextBlock x:Name="textBlockTitle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Solid Model Browser" Foreground="{DynamicResource WindowFore}" Opacity="0.85"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                <!-- Right: Theme & Windows 11 Chrome Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ButtonChangeTheme" Width="30" Height="30" ToolTip="Switch Theme">
                        <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8,2 A6,6 0 0,0 8,14 Z" Fill="{DynamicResource WindowFore}" Opacity="0.35"/>
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <StackPanel x:Name="StackPanelSystemButtons" Orientation="Horizontal">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Separator}" Margin="4,0"/>
                        <Button x:Name="ButtonMinimize" Width="30" Height="30" ToolTip="Minimize">
                            <Path Data="M2,7 L12,7" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="ButtonMaximize" Width="30" Height="30" ToolTip="Maximize">
                            <Path Data="M2,2 L12,2 L12,12 L2,12 Z" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="ButtonClose" Width="30" Height="30" ToolTip="Close">
                            <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{DynamicResource WindowFore}" StrokeThickness="1.2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- MAIN WORKSPACE: SIDEBAR + VIEWPORT + SLICER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilePanelColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Opaque File Navigation Panel (Hidden by default, zero startup flicker) -->
                <local:FileNavigationPanel x:Name="filePanel" Visibility="Collapsed" Background="{DynamicResource PanelBack}" Foreground="{DynamicResource WindowFore}" Padding="0,0,5,0" Grid.Column="0"/>

                <GridSplitter x:Name="FilePanelSplitter" Visibility="Collapsed" Background="{DynamicResource TransparentHandle}" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeBehavior="CurrentAndNext"/>

                <!-- Model Info Floating HUD Card (Toggled via I key, cleared from right slider) -->
                <Border x:Name="infoContainer" Margin="16,16,44,16" CornerRadius="6" Background="{DynamicResource InfoPanel}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="textBlockInfo" FontSize="11" Foreground="{DynamicResource WindowFore}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Progress Bar Container -->
                <Border x:Name="borderProgressContainer" Visibility="Hidden" Width="108" Height="20" CornerRadius="4" BorderThickness="1" Padding="2" BorderBrush="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="borderProgress" Width="50" Height="16" CornerRadius="4" BorderThickness="1" Background="{DynamicResource WindowFore}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>

                <!-- Z-Height Slicer (Vertical on Right, Circular Thumb) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Margin="8,24,18,24">
                    <Slider x:Name="sliderSliceHeight" Orientation="Vertical" SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
